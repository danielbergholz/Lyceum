<header class="navbar border-b border-[#3d6868] bg-[#163f43] px-4 py-4 text-[#f6f4ed] sm:px-6 lg:px-8">
  <div class="flex-1">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-[#d88b69] text-sm text-[#163f43]">L</span>
      <span class="text-lg">Lyceum</span>
    </a>
  </div>
  <div class="flex-none">
    <ul class="flex items-center gap-1 sm:gap-2">
      <li class="hidden sm:block"><a href="#features" class="btn btn-ghost btn-sm text-[#b9d0ca] hover:bg-[#29575a] hover:text-[#f6f4ed]">Principles</a></li>
      <li><a href="https://github.com/danielbergholz/lyceum" class="btn btn-ghost btn-sm text-[#b9d0ca] hover:bg-[#29575a] hover:text-[#f6f4ed]">GitHub</a></li>
      <li><Layouts.theme_toggle /></li>
    </ul>
  </div>
</header>

<main>
  <section class="bg-[#163f43] text-[#f6f4ed]">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 lg:py-40">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#e6a07f]">Learning, on your terms</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-extrabold leading-[0.95] tracking-[-0.065em] text-balance sm:text-7xl lg:text-8xl">Your school. Your courses. Your data.</h1>
        <p class="mt-8 max-w-xl text-lg leading-8 text-[#b9d0ca] sm:text-xl">Lyceum is an open source learning platform for schools that want the freedom to teach without vendor lock-in.</p>
        <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row">
          <a href="https://github.com/danielbergholz/lyceum" class="btn border-0 bg-[#f6f4ed] px-6 text-[#163f43] shadow-none transition-transform hover:-translate-y-0.5 hover:bg-white">Build with Lyceum <span aria-hidden="true">&rarr;</span></a>
          <a href="#features" class="btn btn-outline border-[#52736f] px-6 text-[#f6f4ed] hover:border-[#f6f4ed] hover:bg-[#29575a]">Read the principles</a>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="bg-[#f6f4ed] text-[#163f43]">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#ad684c]">A different kind of LMS</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">The platform should serve the classroom.</h2>
        <p class="mt-4 text-lg leading-8 text-[#5d716f]">Lyceum gives schools the essentials to create, run, and understand courses — with the freedom to shape the rest.</p>
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <article class="rounded-xl border border-[#d9dfd7] bg-white/70 p-6 transition-transform hover:-translate-y-1">
          <div class="flex size-11 items-center justify-center rounded-lg bg-[#dcebe5] text-[#276b68]"><.icon name="hero-book-open" class="size-5" /></div>
          <h3 class="mt-6 text-xl font-bold">Create courses</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#5d716f]">Write lessons in Markdown with live preview. Reorder, draft, and publish at your own pace.</p>
        </article>
        <article class="rounded-xl border border-[#d9dfd7] bg-white/70 p-6 transition-transform hover:-translate-y-1">
          <div class="flex size-11 items-center justify-center rounded-lg bg-[#dcebe5] text-[#276b68]"><.icon name="hero-user-group" class="size-5" /></div>
          <h3 class="mt-6 text-xl font-bold">Teach cohorts</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#5d716f]">Run courses on your schedule. Enroll students by email or shareable invite links.</p>
        </article>
        <article class="rounded-xl border border-[#d9dfd7] bg-white/70 p-6 transition-transform hover:-translate-y-1">
          <div class="flex size-11 items-center justify-center rounded-lg bg-[#dcebe5] text-[#276b68]"><.icon name="hero-chart-bar" class="size-5" /></div>
          <h3 class="mt-6 text-xl font-bold">Track progress</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#5d716f]">See who's moving and who's stuck. Completion tracking per lesson and per course.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-[#3d6868] bg-[#29575a] text-[#f6f4ed]">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#e6a07f]">Ownership by design</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Your infrastructure is a feature.</h2>
        <p class="mt-4 text-lg text-[#b9d0ca]">Your data stays on your infrastructure. No subscriptions, no per-student fees, no vendor lock-in.</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-[#52736f] bg-[#163f43] p-5 text-center"><div class="text-3xl font-bold">Docker</div><p class="mt-1 text-xs text-[#b9d0ca]">Compose setup</p></div>
        <div class="rounded-xl border border-[#52736f] bg-[#163f43] p-5 text-center"><div class="text-3xl font-bold">Postgres</div><p class="mt-1 text-xs text-[#b9d0ca]">Your database</p></div>
        <div class="rounded-xl border border-[#52736f] bg-[#163f43] p-5 text-center"><div class="text-3xl font-bold">SMTP</div><p class="mt-1 text-xs text-[#b9d0ca]">Bring your mail</p></div>
        <div class="rounded-xl border border-[#52736f] bg-[#163f43] p-5 text-center"><div class="text-3xl font-bold">MIT</div><p class="mt-1 text-xs text-[#b9d0ca]">Open source</p></div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 text-[#163f43] sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#ad684c]">Under the hood</p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Built for a long life.</h2>
      <p class="mt-4 text-lg leading-8 text-[#5d716f]">Real-time, fault-tolerant, and built on a stack that is a joy to maintain.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">Phoenix {Application.spec(:phoenix, :vsn)}</span>
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">LiveView</span>
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">Elixir</span>
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">PostgreSQL</span>
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">Tailwind CSS</span>
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">daisyUI</span>
      <span class="rounded-full border border-[#c6d7d1] px-4 py-2 text-sm">Bandit</span>
    </div>
    <div class="mt-16 text-center">
      <p class="text-sm text-[#6c817d]">Lyceum is in early development. Features are being built issue-by-issue.<br class="hidden sm:block" /> Contributions and feedback are welcome.</p>
      <div class="mt-6 flex justify-center gap-4">
        <a href="https://github.com/danielbergholz/lyceum/issues" class="text-sm text-[#276b68] underline decoration-[#b9d0ca] underline-offset-4 transition-colors hover:text-[#ad684c]">View open issues &rarr;</a>
        <a href="https://github.com/danielbergholz/lyceum" class="text-sm text-[#276b68] underline decoration-[#b9d0ca] underline-offset-4 transition-colors hover:text-[#ad684c]">Contribute on GitHub &rarr;</a>
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-[#3d6868] bg-[#163f43] text-[#b9d0ca]">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex items-center gap-2 text-sm"><span class="grid size-5 place-items-center rounded bg-[#d88b69] text-xs font-bold text-[#163f43]">L</span><span>Lyceum</span></div>
      <p class="text-xs text-[#789b94]">Open source learning management system &mdash; MIT licensed</p>
      <a href="https://github.com/danielbergholz/lyceum" class="text-[#789b94] transition-colors hover:text-[#f6f4ed]"><.icon name="hero-code-bracket" class="size-5" /></a>
    </div>
  </div>
</footer>
