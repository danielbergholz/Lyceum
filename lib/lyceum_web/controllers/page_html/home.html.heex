<!--
data-tw-container="Homepage Header"
data-tw-variant="Default"
-->

<header class="navbar px-4 sm:px-6 lg:px-8 py-3 border-b border-base-200">
  <div class="flex-1">
    <a href="/" class="flex items-center gap-2">
      <img src={~p"/images/logo.svg"} width="36" class="text-primary" />
      <span class="text-lg font-bold tracking-tight">Lyceum</span>
    </a>
  </div>
  <div class="flex-none">
    <ul class="flex items-center gap-1 sm:gap-2">
      <li class="hidden sm:block">
        <a href="#features" class="btn btn-ghost btn-sm">Features</a>
      </li>
      <li>
        <a href="https://github.com/danielbergholz/lyceum" class="btn btn-ghost btn-sm">
          GitHub
        </a>
      </li>
      <li>
        <Layouts.theme_toggle />
      </li>
    </ul>
  </div>
</header>

<main>
  <div class="relative overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent pointer-events-none"
      aria-hidden="true"
    />
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <div class="flex justify-center mb-6">
          <span class="badge badge-soft badge-primary badge-sm tracking-wide uppercase text-xs">
            Early Stage
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-balance">
          Open source learning management system
        </h1>
        <p class="mt-6 text-lg sm:text-xl leading-8 text-base-content/70 max-w-2xl mx-auto">
          Create courses, teach cohorts, and track student progress.
          Built for schools that want to own their infrastructure.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://github.com/danielbergholz/lyceum" class="btn btn-primary btn-wide">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-current">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 0C5.37 0 0 5.506 0 12.303c0 5.445 3.435 10.043 8.205 11.674.6.107.825-.262.825-.585 0-.292-.015-1.261-.015-2.291C6 21.67 5.22 20.346 4.98 19.654c-.135-.354-.72-1.446-1.23-1.738-.42-.23-1.02-.8-.015-.815.945-.015 1.62.892 1.845 1.261 1.08 1.86 2.805 1.338 3.495 1.015.105-.8.42-1.338.765-1.645-2.67-.308-5.46-1.37-5.46-6.075 0-1.338.465-2.446 1.23-3.307-.12-.308-.54-1.569.12-3.26 0 0 1.005-.323 3.3 1.26.96-.276 1.98-.415 3-.415s2.04.139 3 .416c2.295-1.6 3.3-1.261 3.3-1.261.66 1.691.24 2.952.12 3.26.765.861 1.23 1.953 1.23 3.307 0 4.721-2.805 5.767-5.475 6.075.435.384.81 1.122.81 2.276 0 1.645-.015 2.968-.015 3.383 0 .323.225.707.825.585a12.047 12.047 0 0 0 5.919-4.489A12.536 12.536 0 0 0 24 12.304C24 5.505 18.63 0 12 0Z"
              />
            </svg>
            Star on GitHub
          </a>
          <a href="#features" class="btn btn-outline btn-wide">
            Learn more <span aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24" id="features">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Everything you need to teach</h2>
      <p class="mt-4 text-base-content/70 text-lg">
        Lyceum gives schools everything to create, run, and track courses — without vendor lock-in.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <div class="card bg-base-200/50 border border-base-200">
        <div class="card-body items-center text-center">
          <div class="size-12 rounded-box bg-primary/10 flex items-center justify-center text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
              />
            </svg>
          </div>
          <h3 class="card-title text-xl">Create Courses</h3>
          <p class="text-base-content/70 text-sm leading-relaxed">
            Write lessons in Markdown with live preview. Reorder, draft, and publish at your own pace.
          </p>
        </div>
      </div>

      <div class="card bg-base-200/50 border border-base-200">
        <div class="card-body items-center text-center">
          <div class="size-12 rounded-box bg-primary/10 flex items-center justify-center text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"
              />
            </svg>
          </div>
          <h3 class="card-title text-xl">Teach Cohorts</h3>
          <p class="text-base-content/70 text-sm leading-relaxed">
            Run courses on your schedule. Enroll students by email or shareable invite links.
          </p>
        </div>
      </div>

      <div class="card bg-base-200/50 border border-base-200">
        <div class="card-body items-center text-center">
          <div class="size-12 rounded-box bg-primary/10 flex items-center justify-center text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"
              />
            </svg>
          </div>
          <h3 class="card-title text-xl">Track Progress</h3>
          <p class="text-base-content/70 text-sm leading-relaxed">
            See who's moving and who's stuck. Completion tracking per lesson and per course.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-base-200/30 border-y border-base-200">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="mx-auto max-w-2xl text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Self-hostable from day one</h2>
        <p class="mt-4 text-base-content/70 text-lg">
          Your data stays on your infrastructure. No subscriptions, no per-student fees, no vendor lock-in.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="card bg-base-100 border border-base-200">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-primary">Docker</div>
            <p class="text-xs text-base-content/60 mt-1">Compose setup</p>
          </div>
        </div>
        <div class="card bg-base-100 border border-base-200">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-primary">Postgres</div>
            <p class="text-xs text-base-content/60 mt-1">Your database</p>
          </div>
        </div>
        <div class="card bg-base-100 border border-base-200">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-primary">SMTP</div>
            <p class="text-xs text-base-content/60 mt-1">Bring your mail</p>
          </div>
        </div>
        <div class="card bg-base-100 border border-base-200">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-primary">MIT</div>
            <p class="text-xs text-base-content/60 mt-1">Open source</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Built with Elixir & Phoenix</h2>
      <p class="mt-4 text-base-content/70 text-lg">
        Real-time, fault-tolerant, and battle-tested at scale. The same stack used by
        WhatsApp, Discord, and Bleacher Report.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <span class="badge badge-lg badge-soft">Phoenix {Application.spec(:phoenix, :vsn)}</span>
      <span class="badge badge-lg badge-soft">LiveView</span>
      <span class="badge badge-lg badge-soft">Elixir</span>
      <span class="badge badge-lg badge-soft">PostgreSQL</span>
      <span class="badge badge-lg badge-soft">Tailwind CSS</span>
      <span class="badge badge-lg badge-soft">daisyUI</span>
      <span class="badge badge-lg badge-soft">Bandit</span>
    </div>

    <div class="mt-16 text-center">
      <p class="text-base-content/50 text-sm">
        Lyceum is in early development. Features are being built issue-by-issue.
        <br class="hidden sm:block" /> Contributions and feedback are welcome.
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a href="https://github.com/danielbergholz/lyceum/issues" class="link link-hover text-sm">
          View open issues &rarr;
        </a>
        <a href="https://github.com/danielbergholz/lyceum" class="link link-hover text-sm">
          Contribute on GitHub &rarr;
        </a>
      </div>
    </div>
  </div>
</main>

<footer class="border-t border-base-200 bg-base-200/30">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm text-base-content/50">
        <img src={~p"/images/logo.svg"} width="20" class="text-primary" />
        <span>Lyceum</span>
      </div>
      <p class="text-xs text-base-content/40">
        Open source learning management system &mdash; MIT licensed
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/danielbergholz/lyceum"
          class="text-base-content/40 hover:text-base-content transition-colors"
        >
          <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 0C5.37 0 0 5.506 0 12.303c0 5.445 3.435 10.043 8.205 11.674.6.107.825-.262.825-.585 0-.292-.015-1.261-.015-2.291C6 21.67 5.22 20.346 4.98 19.654c-.135-.354-.72-1.446-1.23-1.738-.42-.23-1.02-.8-.015-.815.945-.015 1.62.892 1.845 1.261 1.08 1.86 2.805 1.338 3.495 1.015.105-.8.42-1.338.765-1.645-2.67-.308-5.46-1.37-5.46-6.075 0-1.338.465-2.446 1.23-3.307-.12-.308-.54-1.569.12-3.26 0 0 1.005-.323 3.3 1.26.96-.276 1.98-.415 3-.415s2.04.139 3 .416c2.295-1.6 3.3-1.261 3.3-1.261.66 1.691.24 2.952.12 3.26.765.861 1.23 1.953 1.23 3.307 0 4.721-2.805 5.767-5.475 6.075.435.384.81 1.122.81 2.276 0 1.645-.015 2.968-.015 3.383 0 .323.225.707.825.585a12.047 12.047 0 0 0 5.919-4.489A12.536 12.536 0 0 0 24 12.304C24 5.505 18.63 0 12 0Z"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
